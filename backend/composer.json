{
  "name": "product-display/juniortest",
  "description": "Product display backend — polymorphic domain + layered architecture",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "App/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php vendor/phpunit/phpunit/phpunit -c phpunit.xml --testsuite unit"
  }
}
