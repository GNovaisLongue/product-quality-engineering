# Production environment template.
# Copy to .env.production and fill in real, unique secrets — never commit
# the filled-in file (already covered by .gitignore's `.env*.prod` rule,
# but name it .env.production to match compose.prod.yml's env_file).
#
# Key differences from .env.development:
#  - the app connects as a scoped MYSQL_USER, not MYSQL_ROOT_PASSWORD/root
#  - CORS is locked to the real frontend origin
#  - all passwords are unique, generated secrets — not "root"

VITE_DOMAIN_DB="https://api.your-domain.com"
CORS_ALLOWED_ORIGIN="https://app.your-domain.com"

# App DB user (the official mysql image auto-creates this user with full
# privileges on MYSQL_DATABASE — it is NOT the MySQL root account).
PHP_DSN=ecommerce_products
PHP_HOST=mysql
PHP_USER=app_user
PHP_PASSWD=CHANGE_ME_use_a_generated_secret

MYSQL_DATABASE=ecommerce_products
MYSQL_HOST=mysql
MYSQL_USER=app_user
MYSQL_PASSWORD=CHANGE_ME_use_a_generated_secret
MYSQL_ROOT_PASSWORD=CHANGE_ME_use_a_different_generated_secret
